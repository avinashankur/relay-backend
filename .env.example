# ─── App ──────────────────────────────────────────────────────────────────
# Environment mode. Options: "development" | "test" | "production"
NODE_ENV="development"
PORT=5000
API_BASE_URL="http://localhost:5000"

# ─── Database (Neon Postgres) ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/relay_dev?schema=public"
# DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/relay_dev?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ─── JWT (RS256) ──────────────────────────────────────────────────────────
# PEM-encoded RSA private key used to sign access tokens.
# In production this is loaded from AWS Secrets Manager at startup;
# in dev/test you can paste the PEM (newlines replaced with \n) here.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_DEV_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_DEV_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ─── OAuth ────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_CALLBACK_URL="http://localhost:5000/api/v1/auth/github/callback"

# ─── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY="re_00000000000000000"
EMAIL_FROM="Relay <noreply@relay.dev>"

# ─── AWS ──────────────────────────────────────────────────────────────────
# AWS_REGION="us-east-1"
# AWS_SECRETS_ARN=""

# ─── Sentry ───────────────────────────────────────────────────────────────
# SENTRY_DSN=""

# ─── CSRF ────────────────────────────────────────────────────────────────
# Secret used to sign the CSRF double-submit cookie. Must be at least 32 characters.
# CSRF_SECRET="your-development-csrf-secret-key-at-least-32-chars"

# ─── Cookie ───────────────────────────────────────────────────────────────
# Domain for Set-Cookie headers (e.g. ".relay.dev"). Leave unset in local dev to default to localhost.
# COOKIE_DOMAIN=""

# ─── Rate Limiting ────────────────────────────────────────────────────────
# RATE_LIMIT_GLOBAL_RPM=1000
# RATE_LIMIT_LOGIN_RPM=5

# ─── BullMQ ───────────────────────────────────────────────────────────────
# Optional separate Redis URL for BullMQ queues. Falls back to REDIS_URL when not set.
# BULLMQ_REDIS_URL="redis://localhost:6379/1"

# ─── Frontend ─────────────────────────────────────────────────────────────
# Allowed CORS origin(s) — comma-separated list of URLs.
# CORS_ORIGINS="http://localhost:3001"

# ─── Misc ─────────────────────────────────────────────────────────────────
# Log level for Pino. Options: "trace" | "debug" | "info" | "warn" | "error" | "fatal"
# Default: "info".
LOG_LEVEL="info"
