// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  password
  google
  github
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  avatarUrl     String?
  role          UserRole  @default(USER)
  suspended     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // soft delete - hard delete schedeuled 30 days later

  // Relations
  authAccounts AuthAccount[]
  sessions     Session[]
  auditEvents  AuditEvent[]

  @@index([email])
}

model AuthAccount {
  id         String       @default(cuid())
  provider   AuthProvider
  providerId String? // provider specific UID (null for password provder)
  credential String? // bcrypt hash - only set for AuthProvider
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId]) // prevents duplicate OAuth account links
  @@unique([userId, provider]) // one account per provider per user
  @@index([userId])
  @@map("auth_accounts")
}

// Session
model Session {
  id               String    @id @default(cuid())
  refreshTokenHash String
  rotatedAt        DateTime? // set when token is rotated; enables reuse detection
  expiresAt        DateTime
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  // device info
  ip         String?
  deviceInfo Json?

  // tenant context
  orgId  String?
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshTokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// AuditEvent
// Append-only log of security-relevant actions. Never updated or deleted.
// High write volume — flushed in batches from Redis buffer via cleanup worker.
// 
model AuditEvent {
  id        String   @id @default(cuid())
  action    String // e.g. "auth.login", "session.revoke", "org.role_changed"
  metadata  Json? // non-PII context: { method, sessionId, oldRole, newRole, … }
  ip        String?
  createdAt DateTime @default(now())

  // Both optional: system events may have no userId; cross-org events may have no orgId
  userId String?
  orgId  String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt]) // range queries and exports
  @@index([action]) // filter by event type
  @@map("audit_events")
}
